# Python
__pycache__/
*.pyc
*.pyo

# PyInstaller build artifacts (regenerate via build.bat; the .exe itself is
# also excluded since it's a large binary build output, not source)
build/
dist/
*.spec

# Local tool/editor config (machine-specific, not project source)
.claude/settings.local.json

# OS cruft
Thumbs.db
.DS_Store

# Local save games (user state, not source)
/saves/

# Generated Windows version resources (regenerated by build.bat/build_launcher.bat)
/build_version_game.txt
/build_version_launcher.txt

# Local launcher state (written next to the launcher exe at runtime, not source)
/game_version.txt
/ShapesOfWar.exe.download

# Local "have I seen this changelog" state (per-player, not source).
/changelog_seen.json

# Diagnostic tripwire log from map_view.py's _log_flatgl_timing (see
# shapes_of_war_flatgl_content_cache) -- runtime output, not source.
/flatgl_timing.log

# Packaged build output (the exe is distributed via GitHub Releases, not the repo)
/ShapesOfWar.zip

# Scratch dumps of source chunks left over from editing sessions -- these are
# partial copies of resources.py/trade.py/worldgen.py, not source of their own.
/resources_*.txt
/trade_*.txt
/worldgen_*.txt

# Stray artifact from a shell redirect to NUL on Windows
/nul

# Third-party tool cache
/.freebuff/

# Dev world snapshots used by dev/bench_turn.py and the regression harnesses.
# ~49MB each -- real saves, kept on disk but deliberately out of git.
dev/worlds/

# Globe render dumps from dev/globe_shot.py -- output, not source.
dev/shots/

# Balance overrides written by dev/balance_lab.py -- a local tuning scratchpad,
# not a shared setting. The game runs on source defaults when it is absent.
dev/balance.json
